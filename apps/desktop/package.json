{
  "name": "workrun",
  "version": "0.1.0-rc.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env RUST_BACKTRACE=full tauri dev",
    "build": "tauri build",
    "build:verbose": "tauri build --verbose",
    "ui:dev": "vite --config vite.config.ts",
    "ui:build": "tsc && vite build",
    "preview": "vite preview",
    "prebuild": "pnpm workflow:generate && node scripts/prebuild.mjs && node scripts/build-python-sdk.mjs",
    "tauri": "tauri",
    "updater": "node scripts/updater.mjs",
    "updater-fixed-webview2": "node scripts/updater-fixed-webview2.mjs",
    "set-updater-channel": "node scripts/set-updater-channel.mjs",
    "oxlint": "oxlint src scripts test/e2e wdio.conf.ts --type-aware",
    "oxlint:fix": "oxlint src scripts test/e2e wdio.conf.ts --fix",
    "format": "oxfmt --check src test/e2e wdio.conf.ts",
    "format:write": "oxfmt --write src test/e2e wdio.conf.ts",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "test:component": "vitest run --config vitest.config.ts --project component",
    "test:tauri": "vitest run --config vitest.config.ts --project tauri",
    "test:e2e:build": "node scripts/e2e.mjs build",
    "test:e2e": "node scripts/e2e.mjs",
    "test:browser": "vitest run --config vitest.config.ts --project browser",
    "workflow:generate": "node scripts/generate-workflow-reference.mjs",
    "workflow:check": "node --test scripts/workflow-node-schema.test.mjs && node scripts/generate-workflow-reference.mjs --check"
  },
  "dependencies": {
    "@daveyplate/better-auth-tauri": "^0.1.9",
