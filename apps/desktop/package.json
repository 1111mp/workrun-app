    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@workspace/json-schema-form": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@xyflow/react": "^12.12.1",
    "adm-zip": "^0.6.1",
    "ajv-errors": "^3.0.0",
    "better-auth": "^1.7.20",
    "cron-parser": "^5.10.4",
    "cronstrue": "^3.39.0",
    "i18next": "^27.1.1",
    "immer": "^11.2.10",
    "json-edit-react": "2.0.5",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-draggable": "^4.7.2",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
