    "@dicebear/styles": "^10.6.0",
    "@hookform/resolvers": "^7.0.5",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@json-edit-react/components": "1.1.0",
    "@json-edit-react/themes": "1.0.0",
    "@melloware/react-logviewer": "^6.6.0",
    "@rjsf/utils": "^6.11.1",
    "@rjsf/validator-ajv8": "^6.11.1",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
