{
  "name": "workrun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env RUST_BACKTRACE=full tauri dev",
    "build": "tauri build",
    "build:verbose": "tauri build --verbose",
    "ui:dev": "vite --config vite.config.ts",
    "ui:build": "tsc && vite build",
    "preview": "vite preview",
    "prebuild": "node scripts/prebuild.mjs && node scripts/build-python-sdk.mjs",
    "tauri": "tauri",
    "oxlint": "oxlint src scripts --type-aware",
    "oxlint:fix": "oxlint src scripts --fix",
    "format": "oxfmt --check src",
    "format:write": "oxfmt --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
