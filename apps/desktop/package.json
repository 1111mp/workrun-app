    "@wdio/tauri-service": "^1.5.1",
    "@wdio/types": "^10.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "vite": "^8.3.8",
