{
  "name": "workrun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env RUST_BACKTRACE=full tauri dev",
    "build": "tauri build",
    "build:verbose": "tauri build --verbose",
    "ui:dev": "vite --config vite.config.ts",
