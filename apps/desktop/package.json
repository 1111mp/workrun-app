    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "semver": "^7.8.6",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "yet-another-react-lightbox": "^3.33.0",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0",
    "zundo": "^2.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
