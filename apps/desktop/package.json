    "@workspace/ui": "workspace:*",
    "@xyflow/react": "^12.11.2",
    "ajv-errors": "^3.0.0",
    "immer": "^11.1.16",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^6.0.5",
