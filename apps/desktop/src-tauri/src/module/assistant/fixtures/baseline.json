{
  "version": 1,
  "capabilities": [
    {
      "id": "sales-report",
      "name": "Sales report",
      "description": "Generate a sales report from workspace data. Accepts reporting period. Does not parse invoices or translate documents.",
      "parameters": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "this_week",
              "last_week",
              "this_month"
            ]
          }
        },
        "required": [
          "period"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "invoice-summary",
      "name": "Invoice summary",
      "description": "Summarize provided invoice files, not sales data.",
      "parameters": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "files"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "document-translation",
      "name": "Document translation",
      "description": "Translate supplied text into the requested language. Does not generate reports.",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "enum": [
              "English",
              "Chinese",
              "Japanese"
            ]
          }
        },
        "required": [
          "text",
          "language"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "expense-review",
      "name": "Expense review",
      "description": "Evaluate a supplied expense amount against the 1000-unit review threshold using a local rule. Returns whether manual review is needed. No payments or business mutations.",
      "parameters": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "amount"
        ],
        "additionalProperties": false
      }
    }
  ],
