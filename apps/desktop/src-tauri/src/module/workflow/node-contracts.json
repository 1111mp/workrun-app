      "id": "codeact_agent1",
      "type": "codeact_agent",
      "data": {
        "modelProfileId": "DISCOVER_MODEL_ID",
        "instruction": "Read inputs from authorized resources, calculate results and write files to /outputs.",
        "maxIterations": 8
