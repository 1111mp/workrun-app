---
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
	{
		hasSidebar ? (
			<nav class="sidebar" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
				{/*
					Starlight 0.42 opens its mobile navigation with the Popover API. The
					Obsidian override predates that API, so retain its layout while restoring
					the required popover host and keyboard focus handling.
				*/}
				<script>
					class StarlightSidebarPane extends HTMLElement {
						constructor() {
							super();
							const desktopMediaQuery = matchMedia('(min-width: 50em)');
							const resetPopoverAttribute = () => {
								this.popover = desktopMediaQuery.matches ? null : 'auto';
							};

							resetPopoverAttribute();
							desktopMediaQuery.addEventListener('change', resetPopoverAttribute);
							this.addEventListener('toggle', ({ newState }) => this.trapFocus(newState === 'open'));
						}

						trapFocus(shouldTrap: boolean) {
							// Keep the header toggle interactive so keyboard users can also close the menu.
							document
								.querySelectorAll<HTMLElement>('.main-frame > :not(.mobile-header), .sl-skip-link')
								.forEach((element) => element.toggleAttribute('inert', shouldTrap));
						}
					}

					customElements.define('sl-sidebar-pane', StarlightSidebarPane);
				</script>
				<sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
					<div class="sidebar-content sl-flex">
						<slot name="sidebar" />
					</div>
				</sl-sidebar-pane>
			</nav>
		) : (
			<header class="header"><slot name="header" /></header>
		)
	}
	<div class="main-frame">
		{hasSidebar && (
			<div class="mobile-header">
				<div class="title-wrapper">
					<SiteTitle />
				</div>
				<MobileTableOfContents />
				<MobileMenuToggle />
			</div>
		)}
		<slot />
	</div>
</div>

<script>
	const previewDialogId = 'workrun-image-preview';
	let previewDialog = document.querySelector<HTMLDialogElement>(
		`#${previewDialogId}`,
	);

	if (!previewDialog) {
		previewDialog = document.createElement('dialog');
		previewDialog.id = previewDialogId;
		previewDialog.className = 'workrun-image-preview-dialog';
		previewDialog.innerHTML = `
			<div class="workrun-image-preview-frame">
				<button class="workrun-image-preview-close" type="button" aria-label="Close image preview">×</button>
				<img class="workrun-image-preview-image" alt="" />
			</div>
		`;
		document.body.append(previewDialog);
	}

	const previewImage = previewDialog.querySelector<HTMLImageElement>(
		'.workrun-image-preview-image',
	);
	const closeButton = previewDialog.querySelector<HTMLButtonElement>(
		'.workrun-image-preview-close',
	);
	let previewTrigger: HTMLImageElement | undefined;

	function isPreviewableImage(target: EventTarget | null): target is HTMLImageElement {
		return (
			target instanceof HTMLImageElement &&
			target.matches('.sl-markdown-content img:not([data-no-preview])')
		);
	}

	function openImagePreview(image: HTMLImageElement) {
		if (!previewImage || previewDialog?.open) return;
		previewTrigger = image;
		previewImage.src = image.currentSrc || image.src;
		previewImage.alt = image.alt;
		previewDialog?.showModal();
		closeButton?.focus();
	}

	// Markdown images stay authored as plain images; enhance them once here so every
	// documentation screenshot gets the same accessible preview without custom markup.
	document
		.querySelectorAll<HTMLImageElement>('.sl-markdown-content img:not([data-no-preview])')
		.forEach((image) => {
			image.tabIndex = 0;
			image.setAttribute('role', 'button');
			image.setAttribute('aria-haspopup', 'dialog');
			image.setAttribute(
				'aria-label',
				image.alt ? `Preview image: ${image.alt}` : 'Preview image',
			);
		});

	document.addEventListener('click', (event) => {
		if (isPreviewableImage(event.target)) openImagePreview(event.target);
	});

	document.addEventListener('keydown', (event) => {
		if (
			(event.key === 'Enter' || event.key === ' ') &&
			isPreviewableImage(event.target)
		) {
			event.preventDefault();
			openImagePreview(event.target);
		}
	});

	closeButton?.addEventListener('click', () => previewDialog?.close());
	previewDialog.addEventListener('click', (event) => {
		if (event.target === previewDialog) previewDialog.close();
	});
	previewDialog.addEventListener('close', () => {
		previewImage?.removeAttribute('src');
		previewTrigger?.focus();
		previewTrigger = undefined;
	});
</script>

<style>
	@layer starlight.core {
		.page {
			flex-direction: column;
			min-height: 100vh;
		}

		.header {
			z-index: var(--sl-z-index-navbar);
			position: fixed;
			inset-inline-start: 0;
			inset-block-start: 0;
			width: 100%;
			height: var(--sl-nav-height);
			border-bottom: 1px solid var(--sl-color-hairline-shade);
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			padding-inline-end: var(--sl-nav-pad-x);
			background-color: var(--sl-color-bg-nav);
		}

		:global([data-has-sidebar]) .header {
			padding-inline-end: calc(
				var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
			);
		}

		.sidebar-pane {
			/* Reset browser popover defaults without changing the Obsidian layout rules. */
			border: unset;
			padding: unset;
			height: unset;
			color: unset;
			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset-block: var(--sl-nav-height) 0;
			inset-inline-start: 0;
			width: 100%;
			background-color: var(--sl-color-black);
			overflow-y: auto;
		}

		.sidebar-content {
			height: 100%;
			min-height: max-content;
			padding: 1rem var(--sl-sidebar-pad-x) 0;
			flex-direction: column;
			gap: 1rem;
		}

		@media (min-width: 50rem) {
			.sidebar-content::after {
				content: '';
				padding-bottom: 1px;
			}

			:global([data-has-sidebar]) .header {
				padding-inline-end: var(--sl-nav-pad-x);
			}

			.sidebar-pane {
				display: block;
				width: var(--sl-sidebar-width);
				background-color: var(--sl-color-bg-sidebar);
				border-inline-end: 1px solid var(--sl-color-hairline-shade);
			}
		}
	}
</style>
