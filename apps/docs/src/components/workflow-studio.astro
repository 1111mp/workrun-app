---
const isEnglish = Astro.currentLocale === 'en';
const copy = isEnglish
  ? {
      title: 'From a plan to a visible workflow',
      description: 'This order-cancellation workflow checks an order, routes by risk, and hands high-risk cases to a separate branch. See how each step connects before you run it.',
      alt: 'Workrun workflow editor showing order authentication, risk checking, and branches for review handoff or order cancellation',
      enlarge: 'View full-size screenshot',
    }
  : {
      title: '从编排方案，到看得见的流程',
      description: '以订单取消为例：先鉴权并提取订单号，再检查风险，按风险结果进入审核交接或取消订单分支。运行之前，就能看清每一步如何连接。',
      alt: 'Workrun 工作流编辑器：订单鉴权、风险检查，以及通往人工审核交接或取消订单的条件分支',
      enlarge: '查看完整截图',
    };
---

<figure class='editor-preview'>
  <a class='editor-preview-image' href='/media/homepage/workflow-editor-light.png' target='_blank' rel='noopener noreferrer' aria-label={copy.enlarge}>
    <img
      src='/media/homepage/workflow-editor-light.png'
      alt={copy.alt}
      width='3840'
      height='2160'
      loading='lazy'
      decoding='async'
    />
  </a>
  <figcaption>
    <div>
      <strong>{copy.title}</strong>
      <p>{copy.description}</p>
    </div>
    <a href='/media/homepage/workflow-editor-light.png' target='_blank' rel='noopener noreferrer'>
      {copy.enlarge} <span aria-hidden='true'>↗</span>
    </a>
  </figcaption>
</figure>

<style>
  .editor-preview {
    margin: 2rem 0 3rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.85rem;
    background: var(--sl-color-bg);
  }
  .editor-preview-image { display: block; }
  .editor-preview-image img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
  figcaption {
    display: flex;
    align-items: start;
    gap: 1rem 2rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    border-top: 1px solid var(--sl-color-hairline);
  }
  figcaption strong { color: var(--sl-color-white); }
  figcaption p {
    margin: 0.5rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    line-height: 1.7;
  }
  figcaption > a {
    flex-shrink: 0;
    font-size: 0.85rem;
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -3px;
  }
  @media (max-width: 42rem) {
    figcaption { flex-direction: column; }
  }
</style>
