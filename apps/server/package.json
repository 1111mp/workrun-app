{
  "name": "workrun-server",
  "version": "0.0.1",
  "description": "Workrun backend API server built with NestJS, MongoDB, and Better Auth.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "oxlint": "oxlint src test --type-aware",
    "oxlint:fix": "oxlint src test --fix",
    "format": "oxfmt --check src",
    "format:write": "oxfmt --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.1",
    "@daveyplate/better-auth-tauri": "^0.1.9",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "^1.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dompurify": "^3.4.14",
    "fs-extra": "^11.4.0",
    "jsdom": "^30.0.1",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.3",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "unique-filename": "^6.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
