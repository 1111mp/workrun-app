SERVER_PORT=3000
SERVER_BASE_URL=http://localhost:3000

# MongoDB configuration for Docker Compose
MONGO_INITDB_ROOT_USERNAME=workrun
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-password
# For local development without Compose, point this at your own MongoDB instance.
MONGODB_URI=mongodb://workrun:replace-with-a-strong-password@localhost:27017/workrun?authSource=admin

# Secret used by Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# Better Auth GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Better Auth Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Feishu Open Platform application credentials
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""

# LOG
LOG_LEVEL="debug"
LOG_DIR="./logs"
