SERVER_PORT=3000
SERVER_BASE_URL=http://localhost:3000

# MongoDB configuration for Docker Compose
MONGO_INITDB_ROOT_USERNAME=workrun
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-password
# For local development without Compose, point this at your own MongoDB instance.
MONGODB_URI=mongodb://workrun:replace-with-a-strong-password@localhost:27017/workrun?authSource=admin

# Secret used by Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# Better Auth GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Better Auth Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Feishu Open Platform application credentials
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""

# LOG
LOG_LEVEL="debug"
LOG_DIR="./logs"

# Optional: enable team model access through LiteLLM (all four are required).
# The virtual key must belong to this LiteLLM Team; never use the master key.
# LITELLM_BASE_URL=http://localhost:4000/v1
# LITELLM_TEAM_KEY=replace-with-a-team-virtual-key
# LITELLM_TEAM_ID=your-litellm-team-id
# Stable and unique per Workrun installation; used to namespace End Users.
# LITELLM_DEPLOYMENT_ID=workrun-production
# Total chat request timeout, including streaming, in milliseconds.
# LITELLM_TIMEOUT_MS=300000
