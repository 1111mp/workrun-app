# Choose a reviewed release tag or digest for production.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
LITELLM_BIND=127.0.0.1
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-replace-with-a-random-secret
LITELLM_SALT_KEY=sk-replace-with-a-different-random-secret
