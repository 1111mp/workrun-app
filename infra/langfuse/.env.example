# Template only. Generate unique credentials in .env; never commit .env.
# See README.md for first-time setup.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_VALUE
SALT=REPLACE_WITH_RANDOM_VALUE
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_VALUE
CLICKHOUSE_PASSWORD=REPLACE_WITH_RANDOM_VALUE
REDIS_AUTH=REPLACE_WITH_RANDOM_VALUE
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_VALUE
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/postgres
TELEMETRY_ENABLED=false
LANGFUSE_INIT_ORG_ID=workrun-local
LANGFUSE_INIT_ORG_NAME=Workrun Local
LANGFUSE_INIT_PROJECT_ID=workrun-desktop
LANGFUSE_INIT_PROJECT_NAME=Workrun Desktop
LANGFUSE_INIT_USER_EMAIL=admin@workrun.local
LANGFUSE_INIT_USER_NAME=Workrun Admin
LANGFUSE_INIT_USER_PASSWORD=REPLACE_WITH_RANDOM_VALUE
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-REPLACE_WITH_RANDOM_VALUE
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-REPLACE_WITH_RANDOM_VALUE
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
LANGFUSE_AUTH=Basic REPLACE_WITH_BASE64_PUBLIC_KEY_COLON_SECRET_KEY
