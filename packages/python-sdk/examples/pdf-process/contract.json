{
  "inputs": {
    "document": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "artifact"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "const": 1
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "const": "application/pdf"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["$type", "id", "version", "name", "mimeType", "size"],
      "additionalProperties": false
    }
  },
  "outputs": {
    "pageCount": {
      "type": "integer",
      "minimum": 1
    },
    "textPageCount": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "artifact"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "const": 1
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["$type", "id", "version", "name", "mimeType", "size"],
      "additionalProperties": false
    },
    "processedPdf": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "artifact"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "const": 1
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "const": "application/pdf"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["$type", "id", "version", "name", "mimeType", "size"],
      "additionalProperties": false
    }
  }
}
